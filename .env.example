OPENAI_API_KEY=your_openai_api_key_here

# API Config
API_HOST=0.0.0.0
API_PORT=8000
THREAD_POOL_LIMIT=100
ALLOWED_ORIGINS=*

# DB Config
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=healthleteai_db
