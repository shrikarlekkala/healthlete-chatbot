OPENAI_API_KEY=your_openai_api_key_here

# API Config
API_HOST=0.0.0.0
API_PORT=8000
THREAD_POOL_LIMIT=100
ALLOWED_ORIGINS=*

# DB Config
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_NAME=healthleteai_db
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_POOL_TIMEOUT=10.0

# AI Models
CHAT_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
WEB_SEARCH_MODEL=gpt-4.1

# AI Tuning
RETRIEVAL_LIMIT=8
SIMILARITY_THRESHOLD=0.75
MAX_TOKENS=800
CHAT_TEMPERATURE=0.2
HISTORY_TURNS=3

# Security Config
# Generate each key with: openssl rand -hex 32
CHAT_API_KEY=generate_a_long_random_secret
RATE_LIMIT_PER_MINUTE=10
MAX_QUERY_LENGTH=500

# Brand assistant (called only by the NestJS backend).
# Must be a different key from CHAT_API_KEY.
ASSISTANT_API_KEY=generate_a_different_long_random_secret
ASSISTANT_PLAN_MODEL=gpt-4o-mini
ASSISTANT_ANSWER_MODEL=gpt-4o-mini
ASSISTANT_MAX_TOKENS=450
ASSISTANT_RATE_LIMIT_PER_MINUTE=30
